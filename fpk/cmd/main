#!/bin/bash
# Synology-style supervisor: one long-running loop owns hbbs/hbbr/rustdesk-api.
# Config panel reloads by killing rustdesk-api; this loop stops the rest,
# re-reads wizard/config, and starts all three again.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "${SCRIPT_DIR}/_common"

LOG_FILE="${DATA_DIR}/rustdesk-server.log"
PID_FILE="${DATA_DIR}/rustdesk-server.pid"
RUNTIME_DIR="${DATA_DIR}/runtime"
DATA_KEYS="${DATA_DIR}/data"
APPLIED_MARK="${DATA_DIR}/config.applied"
HBBS_INIT_PORT=39116

HBBS_BIN="${APP_DIR}/bin/hbbs"
HBBR_BIN="${APP_DIR}/bin/hbbr"
API_BIN="${APP_DIR}/bin/rustdesk-api"

log_msg() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "${LOG_FILE}" 2>/dev/null || true
}

ensure_dirs() {
	mkdir -p "${DATA_DIR}" "${RUNTIME_DIR}" "${DATA_KEYS}" "${DATA_DIR}/logs" 2>/dev/null || true
	if [ ! -f "${CONF_DIR}/config.yaml" ] && [ -f "${APP_DIR}/conf/config.yaml" ]; then
		mkdir -p "${CONF_DIR}" "${CONF_DIR}/admin" 2>/dev/null || true
		cp -f "${APP_DIR}/conf/config.yaml" "${CONF_DIR}/config.yaml"
		[ -f "${APP_DIR}/conf/admin/hello.html" ] && cp -f "${APP_DIR}/conf/admin/hello.html" "${CONF_DIR}/admin/hello.html"
	fi
	if [ -n "${CONF_DIR}" ] && [ "${CONF_DIR}" != "${DATA_DIR}/conf" ]; then
		ln -sfn "${CONF_DIR}" "${DATA_DIR}/conf" 2>/dev/null || true
	fi
	ln -sfn "${APP_DIR}/resources" "${DATA_DIR}/resources" 2>/dev/null || true
}

read_jwt_key() {
	local cfg=$1
	awk '
		/^jwt:/{f=1; next}
		f && /^[^[:space:]#]/{f=0}
		f && /^[[:space:]]*key:[[:space:]]*/ {
			line=$0
			sub(/^[[:space:]]*key:[[:space:]]*/, "", line)
			gsub(/"/, "", line)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
			print line
			exit
		}
	' "${cfg}"
}

write_jwt_key() {
	local cfg=$1
	local key=$2
	awk -v key="${key}" '
		BEGIN { in_jwt=0; done=0 }
		/^jwt:/ { in_jwt=1; print; next }
		in_jwt && /^[^[:space:]#]/ { in_jwt=0 }
		in_jwt && !done && /^[[:space:]]*key:[[:space:]]*/ {
			match($0, /^[[:space:]]*/)
			print substr($0, 1, RLENGTH) "key: \"" key "\""
			done=1
			next
		}
		{ print }
	' "${cfg}" > "${cfg}.tmp" && mv "${cfg}.tmp" "${cfg}"
}

ensure_jwt_key() {
	local cfg="${CONF_DIR}/config.yaml"
	[ -f "${cfg}" ] || return 0
	local key
	key=$(read_jwt_key "${cfg}")
	if [ -z "${key}" ]; then
		key=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
		write_jwt_key "${cfg}" "${key}"
	fi
	export RUSTDESK_API_JWT_KEY="${key}"
}

ensure_server_key() {
	if [ ! -s "${DATA_KEYS}/id_ed25519.pub" ]; then
		log_msg "Generating server keypair on port ${HBBS_INIT_PORT}..."
		(
			cd "${DATA_KEYS}" && "${HBBS_BIN}" -p "${HBBS_INIT_PORT}" -k _ >> "${LOG_FILE}" 2>&1 &
			echo $! > "${DATA_DIR}/hbbs-init.pid"
		)
		local i=0
		while [ "${i}" -lt 15 ]; do
			[ -s "${DATA_KEYS}/id_ed25519.pub" ] && break
			sleep 1
			i=$((i + 1))
		done
		if [ -f "${DATA_DIR}/hbbs-init.pid" ]; then
			local init_pid
			init_pid=$(tr -d '[:space:]' < "${DATA_DIR}/hbbs-init.pid")
			if [ -n "${init_pid}" ]; then
				kill -TERM "${init_pid}" 2>/dev/null || true
				local j=0
				while kill -0 "${init_pid}" 2>/dev/null && [ "${j}" -lt 10 ]; do
					sleep 1
					j=$((j + 1))
				done
				kill -KILL "${init_pid}" 2>/dev/null || true
			fi
			rm -f "${DATA_DIR}/hbbs-init.pid"
		fi
		pgrep -f "${HBBS_BIN}.*-p ${HBBS_INIT_PORT}" >/dev/null 2>&1 && \
			pkill -f "${HBBS_BIN}.*-p ${HBBS_INIT_PORT}" 2>/dev/null || true
	fi
	local pub cfg
	pub=$(cat "${DATA_KEYS}/id_ed25519.pub" 2>/dev/null || true)
	cfg="${CONF_DIR}/config.yaml"
	if [ -n "${pub}" ] && [ -f "${cfg}" ]; then
		awk -v pub="${pub}" '
			BEGIN{inrd=0; done=0}
			/^rustdesk:/{inrd=1}
			inrd && /^[[:space:]]*key:[[:space:]]*""[[:space:]]*$/ && !done {
				sub(/""/, "\"" pub "\"")
				done=1
			}
			/^[^[:space:]#]/ && !/^rustdesk:/{inrd=0}
			{print}
		' "${cfg}" > "${cfg}.tmp" && mv "${cfg}.tmp" "${cfg}"
	fi
}

alive() {
	kill -0 "$1" 2>/dev/null
}

# PIDs matching our package binaries (exclude init keygen port briefly by path alone).
pids_of() {
	pgrep -f "$1" 2>/dev/null || true
}

stop_pattern() {
	local pattern=$1
	local pids
	pids=$(pids_of "${pattern}")
	for pid in ${pids}; do
		kill -TERM "${pid}" 2>/dev/null || true
	done
	local i=0
	while [ "${i}" -lt 15 ]; do
		pids=$(pids_of "${pattern}")
		[ -z "${pids}" ] && break
		sleep 1
		i=$((i + 1))
	done
	pids=$(pids_of "${pattern}")
	for pid in ${pids}; do
		kill -KILL "${pid}" 2>/dev/null || true
	done
}

stop_children() {
	stop_pattern "${HBBS_BIN}"
	stop_pattern "${HBBR_BIN}"
	stop_pattern "${API_BIN}"
}

prepare_runtime() {
	ensure_dirs
	load_wizard_conf
	apply_wizard_to_yaml
	ensure_jwt_key
	ensure_server_key
	apply_wizard_to_yaml
}

mark_config_applied() {
	{
		cat "${CONF_DIR}/wizard.conf" 2>/dev/null || true
		cat "${CONF_DIR}/config.yaml" 2>/dev/null || true
	} | cksum | awk '{print $1" "$2}' > "${APPLIED_MARK}"
}

config_changed() {
	[ -f "${CONF_DIR}/wizard.conf" ] || [ -f "${CONF_DIR}/config.yaml" ] || return 1
	local now
	now=$(
		{
			cat "${CONF_DIR}/wizard.conf" 2>/dev/null || true
			cat "${CONF_DIR}/config.yaml" 2>/dev/null || true
		} | cksum | awk '{print $1" "$2}'
	)
	local old=""
	[ -f "${APPLIED_MARK}" ] && old=$(tr -d '\r\n' < "${APPLIED_MARK}")
	[ "${now}" != "${old}" ]
}

start_children() {
	prepare_runtime

	local MUST_LOGIN="${wizard_must_login:-N}"
	local hbbs_port="${wizard_hbbs_port:-21116}"
	local hbbr_port="${wizard_hbbr_port:-21117}"
	local relay_host="${wizard_host:-}"
	if [ -z "${relay_host}" ] || [ "${relay_host}" = "127.0.0.1" ]; then
		relay_host=""
	fi

	if [ -z "${RUSTDESK_API_JWT_KEY:-}" ]; then
		log_msg "WARN: RUSTDESK_API_JWT_KEY empty; MUST_LOGIN=Y will reject connections"
	fi

	# Synology behavior: -k _ uses local id_ed25519; custom key must be passed to -k
	# or clients using config.yaml rustdesk.key will get "key mismatch".
	local pub=""
	[ -s "${DATA_KEYS}/id_ed25519.pub" ] && pub=$(tr -d '\r\n' < "${DATA_KEYS}/id_ed25519.pub")
	local auth_key="${wizard_key:-}"
	if [ -z "${auth_key}" ]; then
		auth_key=$(awk '
			/^rustdesk:/{f=1; next}
			f && /^[^[:space:]#]/{f=0}
			f && /^[[:space:]]*key:[[:space:]]*/ {
				line=$0
				sub(/^[[:space:]]*key:[[:space:]]*/, "", line)
				gsub(/"/, "", line)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
				print line
				exit
			}
		' "${CONF_DIR}/config.yaml" 2>/dev/null || true)
	fi
	local key_arg="_"
	if [ -n "${auth_key}" ] && [ "${auth_key}" != "${pub}" ]; then
		key_arg="${auth_key}"
		log_msg "Using custom key for hbbs/hbbr (differs from id_ed25519.pub)"
	else
		key_arg="_"
		log_msg "Using local id_ed25519 keypair (-k _)"
	fi

	log_msg "Starting children (MUST_LOGIN=${MUST_LOGIN} ports=${hbbs_port}/${hbbr_port})..."
	export RUSTDESK_API_JWT_KEY
	export MUST_LOGIN
	(
		cd "${DATA_KEYS}"
		if [ -n "${relay_host}" ]; then
			nohup "${HBBS_BIN}" -r "${relay_host}:${hbbr_port}" -p "${hbbs_port}" \
				-k "${key_arg}" --must-login="${MUST_LOGIN}" >> "${LOG_FILE}" 2>&1 &
		else
			nohup "${HBBS_BIN}" -p "${hbbs_port}" -k "${key_arg}" \
				--must-login="${MUST_LOGIN}" >> "${LOG_FILE}" 2>&1 &
		fi
	)
	(
		cd "${DATA_KEYS}"
		nohup "${HBBR_BIN}" -p "${hbbr_port}" -k "${key_arg}" >> "${LOG_FILE}" 2>&1 &
	)
	(
		cd "${DATA_DIR}"
		nohup "${API_BIN}" >> "${LOG_FILE}" 2>&1 &
	)
	sleep 2
	if children_running; then
		mark_config_applied
		log_msg "Children up"
		return 0
	fi
	log_msg "Children failed to stay up (hbbs=$(pids_of "${HBBS_BIN}") hbbr=$(pids_of "${HBBR_BIN}") api=$(pids_of "${API_BIN}"))"
	return 1
}

children_running() {
	local hbbs hbbr api
	hbbs=$(pids_of "${HBBS_BIN}")
	hbbr=$(pids_of "${HBBR_BIN}")
	api=$(pids_of "${API_BIN}")
	[ -n "${hbbs}" ] && [ -n "${hbbr}" ] && [ -n "${api}" ]
}

supervisor_pid() {
	[ -f "${PID_FILE}" ] || return 1
	tr -d '[:space:]' < "${PID_FILE}"
}

supervisor_running() {
	local pid
	pid=$(supervisor_pid) || return 1
	[ -n "${pid}" ] && alive "${pid}"
}

# Long-running loop (Synology daemon equivalent).
supervise() {
	log_msg "Supervisor started"
	trap 'log_msg "Supervisor stopping"; stop_children; rm -f "${PID_FILE}"; exit 0' TERM INT

	while true; do
		local hbbs_pids hbbr_pids api_pids
		hbbs_pids=$(pids_of "${HBBS_BIN}")
		hbbr_pids=$(pids_of "${HBBR_BIN}")
		api_pids=$(pids_of "${API_BIN}")

		# Config panel wrote new wizard/yaml: tear down so next pass reloads.
		if config_changed && { [ -n "${hbbs_pids}" ] || [ -n "${hbbr_pids}" ] || [ -n "${api_pids}" ]; }; then
			log_msg "Config changed; recycling children"
			stop_children
			sleep 1
			continue
		fi

		if [ -z "${hbbs_pids}" ] && [ -z "${hbbr_pids}" ] && [ -z "${api_pids}" ]; then
			start_children || sleep 3
		elif [ -z "${hbbs_pids}" ] || [ -z "${hbbr_pids}" ] || [ -z "${api_pids}" ]; then
			# Same as Synology: any child missing → stop the rest → full restart next loop.
			log_msg "Child missing (hbbs=${hbbs_pids:-none} hbbr=${hbbr_pids:-none} api=${api_pids:-none}); recycling"
			stop_children
			sleep 1
		else
			sleep 2
		fi
	done
}

start_all() {
	if supervisor_running; then
		if children_running; then
			return 0
		fi
		# Supervisor up but children down — give it a moment.
		sleep 3
		children_running && return 0
	fi

	stop_children
	# Drop stale supervisor if any.
	if supervisor_running; then
		local old
		old=$(supervisor_pid)
		kill -TERM "${old}" 2>/dev/null || true
		sleep 1
		kill -KILL "${old}" 2>/dev/null || true
	fi
	rm -f "${PID_FILE}"

	export TRIM_APPDEST TRIM_PKGETC TRIM_PKGVAR
	nohup "${SCRIPT_DIR}/main" supervise >> "${LOG_FILE}" 2>&1 &
	echo $! > "${PID_FILE}"
	sleep 3
	if supervisor_running && children_running; then
		log_msg "Started OK (supervisor $(supervisor_pid))"
		return 0
	fi
	log_msg "Start failed"
	stop_all
	return 1
}

stop_all() {
	log_msg "Stopping RustDesk Server..."
	if supervisor_running; then
		local pid
		pid=$(supervisor_pid)
		kill -TERM "${pid}" 2>/dev/null || true
		local i=0
		while alive "${pid}" 2>/dev/null && [ "${i}" -lt 20 ]; do
			sleep 1
			i=$((i + 1))
		done
		kill -KILL "${pid}" 2>/dev/null || true
	fi
	# Legacy leftover from 1.1.16-6 watcher.
	pkill -f "rustdesk-server-restart-watcher" 2>/dev/null || true
	rm -f "${PID_FILE}" "${DATA_DIR}/watcher.pid" "${DATA_DIR}/restart.request" "${DATA_DIR}/restart.done"
	stop_children
}

status_all() {
	supervisor_running && children_running
}

case "${1:-}" in
	start) start_all ;;
	stop) stop_all ;;
	supervise) supervise ;;
	status)
		if status_all; then
			exit 0
		fi
		exit 3
		;;
	*) exit 1 ;;
esac
