#!/bin/bash
# Start / stop / status for RustDesk Server (hbbs + hbbr + rustdesk-api).
set -uo pipefail

APP_DIR="${TRIM_APPDEST:-}"
DATA_DIR="${TRIM_PKGVAR:-}"
CONF_DIR="${TRIM_PKGETC:-${APP_DIR}/conf}"
LOG_FILE="${DATA_DIR}/rustdesk-server.log"
PID_FILE="${DATA_DIR}/rustdesk-server.pid"
RUNTIME_DIR="${DATA_DIR}/runtime"
DATA_KEYS="${DATA_DIR}/data"
MUST_LOGIN="${MUST_LOGIN:-N}"

log_msg() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "${LOG_FILE}" 2>/dev/null || true
}

ensure_dirs() {
	mkdir -p "${DATA_DIR}" "${RUNTIME_DIR}" "${DATA_KEYS}" "${DATA_DIR}/logs" 2>/dev/null || true
	# Persist config under etc/data; seed from package on first run.
	if [ ! -f "${CONF_DIR}/config.yaml" ] && [ -f "${APP_DIR}/conf/config.yaml" ]; then
		mkdir -p "${CONF_DIR}" "${CONF_DIR}/admin" 2>/dev/null || true
		cp -f "${APP_DIR}/conf/config.yaml" "${CONF_DIR}/config.yaml"
		[ -f "${APP_DIR}/conf/admin/hello.html" ] && cp -f "${APP_DIR}/conf/admin/hello.html" "${CONF_DIR}/admin/hello.html"
	fi
	# Workdir links expected by apimain (relative paths in config.yaml).
	ln -sfn "${CONF_DIR}" "${DATA_DIR}/conf" 2>/dev/null || true
	ln -sfn "${APP_DIR}/resources" "${DATA_DIR}/resources" 2>/dev/null || true
	ln -sfn "${DATA_KEYS}" "${DATA_DIR}/data" 2>/dev/null || true
	ln -sfn "${DATA_DIR}/logs" "${DATA_DIR}/logs" 2>/dev/null || true
}

ensure_jwt_key() {
	local cfg="${CONF_DIR}/config.yaml"
	[ -f "${cfg}" ] || return 0
	local key
	key=$(awk '/^jwt:/{f=1;next} f&&/^[^[:space:]]/{f=0} f&&/key:/{gsub(/[" ]/,""); sub(/^key:/,""); print; exit}' "${cfg}")
	if [ -z "${key}" ]; then
		key=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
		# shellcheck disable=SC2016
		sed -i.bak -E "s|^([[:space:]]*key:[[:space:]]*).*$|\1\"${key}\"|" "${cfg}" 2>/dev/null || \
			sed -i '' -E "s|^([[:space:]]*key:[[:space:]]*).*$|\1\"${key}\"|" "${cfg}"
		rm -f "${cfg}.bak" 2>/dev/null || true
	fi
	export RUSTDESK_API_JWT_KEY="${key}"
}

ensure_server_key() {
	# Generate id_ed25519 by briefly running hbbs if missing.
	if [ ! -s "${DATA_KEYS}/id_ed25519.pub" ]; then
		log_msg "Generating server keypair..."
		(
			cd "${DATA_KEYS}" && "${APP_DIR}/bin/hbbs" -p 21116 -k _ >> "${LOG_FILE}" 2>&1 &
			echo $! > "${DATA_DIR}/hbbs-init.pid"
		)
		local i=0
		while [ "${i}" -lt 15 ]; do
			[ -s "${DATA_KEYS}/id_ed25519.pub" ] && break
			sleep 1
			i=$((i + 1))
		done
		if [ -f "${DATA_DIR}/hbbs-init.pid" ]; then
			kill -TERM "$(cat "${DATA_DIR}/hbbs-init.pid")" 2>/dev/null || true
			rm -f "${DATA_DIR}/hbbs-init.pid"
		fi
		# Official hbbs writes key next to cwd; also check APP_DIR leftovers.
		[ -f "${DATA_KEYS}/id_ed25519" ] || { [ -f ./id_ed25519 ] && mv ./id_ed25519 "${DATA_KEYS}/"; }
		[ -f "${DATA_KEYS}/id_ed25519.pub" ] || { [ -f ./id_ed25519.pub ] && mv ./id_ed25519.pub "${DATA_KEYS}/"; }
	fi
	# Sync public key into config if empty.
	local pub cfg
	pub=$(cat "${DATA_KEYS}/id_ed25519.pub" 2>/dev/null || true)
	cfg="${CONF_DIR}/config.yaml"
	if [ -n "${pub}" ] && [ -f "${cfg}" ]; then
		if grep -qE '^[[:space:]]*key:[[:space:]]*""[[:space:]]*$' "${cfg}"; then
			# Only fill rustdesk.key under rustdesk: block — simple replace of first empty key after rustdesk:
			awk -v pub="${pub}" '
				BEGIN{inrd=0}
				/^rustdesk:/{inrd=1}
				inrd && /^[[:space:]]*key:[[:space:]]*""[[:space:]]*$/ && !done {
					sub(/""/, "\"" pub "\"")
					done=1
				}
				/^[^[:space:]]/ && !/^rustdesk:/{inrd=0}
				{print}
			' "${cfg}" > "${cfg}.tmp" && mv "${cfg}.tmp" "${cfg}"
		fi
	fi
}

alive() {
	local pid=$1
	kill -0 "${pid}" 2>/dev/null
}

status() {
	if [ ! -f "${PID_FILE}" ]; then
		return 1
	fi
	local ok=0
	for pid in $(tr ' ' '\n' < "${PID_FILE}"); do
		[ -z "${pid}" ] && continue
		if alive "${pid}"; then
			ok=1
		else
			return 1
		fi
	done
	[ "${ok}" -eq 1 ]
}

stop_one() {
	local pattern=$1
	local pids
	pids=$(pgrep -f "${pattern}" 2>/dev/null || true)
	for pid in ${pids}; do
		kill -TERM "${pid}" 2>/dev/null || true
	done
	local i=0
	while [ "${i}" -lt 20 ]; do
		pids=$(pgrep -f "${pattern}" 2>/dev/null || true)
		[ -z "${pids}" ] && break
		sleep 1
		i=$((i + 1))
	done
	pids=$(pgrep -f "${pattern}" 2>/dev/null || true)
	for pid in ${pids}; do
		kill -KILL "${pid}" 2>/dev/null || true
	done
}

stop_all() {
	log_msg "Stopping RustDesk Server..."
	stop_one "${APP_DIR}/bin/hbbs"
	stop_one "${APP_DIR}/bin/hbbr"
	stop_one "${APP_DIR}/bin/rustdesk-api"
	rm -f "${PID_FILE}"
}

start_all() {
	if status; then
		return 0
	fi
	ensure_dirs
	ensure_jwt_key
	ensure_server_key

	local hbbs_port=21116
	local hbbr_port=21117
	# "_" lets hbbs/hbbr use the local id_ed25519 keypair in cwd.
	local key_arg="_"

	log_msg "Starting hbbs/hbbr/api (MUST_LOGIN=${MUST_LOGIN})..."
	(
		cd "${DATA_KEYS}"
		export RUSTDESK_API_JWT_KEY
		export MUST_LOGIN
		nohup "${APP_DIR}/bin/hbbs" -r "127.0.0.1:${hbbr_port}" -p "${hbbs_port}" -k "${key_arg}" --must-login="${MUST_LOGIN}" \
			>> "${LOG_FILE}" 2>&1 &
		echo $! >> "${PID_FILE}.tmp"
		nohup "${APP_DIR}/bin/hbbr" -p "${hbbr_port}" -k "${key_arg}" \
			>> "${LOG_FILE}" 2>&1 &
		echo $! >> "${PID_FILE}.tmp"
	)
	(
		cd "${DATA_DIR}"
		export RUSTDESK_API_JWT_KEY
		# apimain expects conf/config.yaml relative to cwd
		nohup "${APP_DIR}/bin/rustdesk-api" >> "${LOG_FILE}" 2>&1 &
		echo $! >> "${PID_FILE}.tmp"
	)
	tr '\n' ' ' < "${PID_FILE}.tmp" > "${PID_FILE}"
	rm -f "${PID_FILE}.tmp"
	sleep 2
	if status; then
		log_msg "Started OK"
		return 0
	fi
	log_msg "Start failed"
	stop_all
	return 1
}

case "${1:-}" in
	start) start_all ;;
	stop) stop_all ;;
	status)
		if status; then
			exit 0
		fi
		exit 3
		;;
	*) exit 1 ;;
esac
