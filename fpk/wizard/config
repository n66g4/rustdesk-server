[
  {
    "stepTitle": "RustDesk 服务配置",
    "items": [
      {
        "type": "tips",
        "helpText": "修改后保存将重写配置并重启服务。API 端口自动 = hbbs−2。非默认端口时域名/IP 必填。Key 也可在桌面配置面板用「自定义 KEY」开关管理。"
      },
      {
        "type": "text",
        "field": "wizard_host",
        "label": "域名 / IP",
        "helpText": "例如 nas.example.com 或 192.168.1.10。默认端口时可留空。",
        "initValue": "",
        "rules": [
          {
            "pattern": "^$|^(([a-zA-Z0-9_-]+\\.)+[a-zA-Z]{2,}|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|([a-fA-F0-9:]+:+)+[a-fA-F0-9]+)$",
            "message": "请输入有效域名或 IP，且不要带端口"
          }
        ]
      },
      {
        "type": "select",
        "field": "wizard_api_scheme",
        "label": "API 协议",
        "initValue": "http",
        "options": [
          { "label": "http", "value": "http" },
          { "label": "https", "value": "https" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_hbbs_port",
        "label": "ID 服务器端口 (hbbs)",
        "helpText": "默认 21116；API = hbbs−2，NAT = hbbs−1，WebSocket = hbbs+2",
        "initValue": "21116",
        "rules": [
          { "required": true, "message": "请输入 ID 端口" },
          { "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "message": "端口范围 1-65535" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_hbbr_port",
        "label": "中继端口 (hbbr)",
        "helpText": "默认 21117；WebSocket 为端口+2",
        "initValue": "21117",
        "rules": [
          { "required": true, "message": "请输入中继端口" },
          { "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$", "message": "端口范围 1-65535" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_key",
        "label": "Key（公钥）",
        "helpText": "留空则保持现有/自动生成的公钥。填写后会写入配置供客户端使用。",
        "initValue": ""
      },
      {
        "type": "select",
        "field": "wizard_must_login",
        "label": "强制登录 (MUST_LOGIN)",
        "helpText": "开启后客户端须先登录 API；需与 JWT 密钥配合。",
        "initValue": "N",
        "options": [
          { "label": "关闭", "value": "N" },
          { "label": "开启", "value": "Y" }
        ]
      }
    ]
  }
]
